---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import WorkRow from '../components/WorkRow.astro';
import { site } from '../data/site';
import { featured, homeItems } from '../data/work';
import { getPublished } from '../lib/collection';
import { workHref } from '../lib/published';

const published = await getPublished();
const slugs = new Set(published.map((e) => e.id));
const caseStudy = published.find((e) => e.id === 'agent-retrieval');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: `${site.url}/`,
  email: `mailto:${site.email}`,
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Purgo AI' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'The University of Texas at Dallas' },
    { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Madras' },
  ],
  homeLocation: { '@type': 'Place', name: site.location },
  sameAs: [site.github, site.linkedin],
  knowsAbout: ['LLM agents', 'Retrieval', 'LLM evaluation', 'Databricks', 'dbt'],
};
---
<BaseLayout title={site.title} description={site.description} ogImage={site.og.home} jsonLd={jsonLd} showName={false}>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title" class="display page-title">{site.name}</h1>
    <p class="lede">Software engineer at Purgo AI, working on its data-engineering agent and the evals behind it.</p>
    <ul class="plain-list dot-list id-line meta" role="list">
      <li>M.S. Computer Science, UT Dallas, 2026</li>
      <li>M.Tech Data Science, IIT Madras, 2024</li>
    </ul>
    <p class="bio">
      I joined Purgo as an intern in June 2025 and went full-time in June 2026. I work across our LangGraph agent for
      data engineering: how it analyzes a ticket, {caseStudy ? <a href="/work/agent-retrieval/">finds the tables it needs</a> : 'finds the tables it needs'}, drafts a design, and writes
      and reviews Databricks and dbt code. I also build the evals and benchmarks we use to decide whether a change
      helped. Before Purgo, I built a <span class="nowrap">text-to-SQL</span> agent at Digitus and forecasting models at PwC.
    </p>
    <ul class="plain-list dot-list link-row" role="list">
      <li><a class="hit" href={site.resume}>Resume (PDF)</a></li>
      <li><a class="hit" href={site.github}>GitHub</a></li>
      <li><a class="hit" href={site.linkedin}>LinkedIn</a></li>
      <li><a class="hit" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </section>

  <section class="featured section" aria-labelledby="featured-title">
    <h2 id="featured-title" class="section-title">Featured</h2>
    <ul class="plain-list cards" role="list">
      {featured.map((item) => <FeaturedCard item={item} href={workHref(slugs, item.page)} />)}
    </ul>
  </section>

  <section class="more-work section" aria-labelledby="more-title">
    <h2 id="more-title" class="section-title">More work</h2>
    <ul class="plain-list rows" role="list">
      {homeItems().map((item) => <WorkRow item={item} href={workHref(slugs, item.page, item.anchor)} />)}
    </ul>
    <p class="more"><a href="/work/">All work, research and coursework</a></p>
  </section>
</BaseLayout>

<style>
  /* Spacing is tuned so the first-screen tests pass at 1280x720 and 390x844 (spec §1). */
  .lede {
    margin-top: 0.75rem;
    font-size: var(--fs-dek);
    line-height: 1.45;
    max-width: 34em;
  }
  .id-line {
    margin-top: 0.75rem;
  }
  .bio {
    margin-top: 1.25rem;
    max-width: var(--measure);
  }
  .link-row {
    margin-top: 1.25rem;
    font-weight: 500;
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .rows {
    margin-top: 1rem;
  }
  .more {
    margin-top: 1.5rem;
    font-weight: 500;
  }
  /* The ID line fits on one row from about 920px up. Below that a wrapped item would start a line with its
     "·", so it stacks with no separators; 60em leaves room for the fallback font being wider. */
  @media (max-width: 60em) {
    .id-line {
      flex-direction: column;
    }
    .id-line.dot-list > li + li::before {
      content: none;
    }
  }
  @media (min-width: 56.25em) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gap);
    }
  }
  @media (max-width: 37.5em) {
    .bio {
      margin-top: 1rem;
    }
    .link-row {
      margin-top: 0.75rem;
    }
  }
</style>
