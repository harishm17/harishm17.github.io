---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import photo from '../assets/harish-manoharan.jpg';
import { site } from '../data/site';
import { studies } from '../data/work';
import { publishedSlugs } from '../lib/collection';
import { workHref } from '../lib/published';
import { aboutJsonLd } from '../lib/structured-data';

const slugs = await publishedSlugs();
const retrieval = workHref(slugs, 'agent-retrieval');
const evaluation = workHref(slugs, 'llm-evaluation');
---
<BaseLayout
  title={`About: ${site.name}`}
  description="Harish Manoharan, a software engineer at Purgo AI, studied biology and data science at IIT Madras and computer science at UT Dallas."
  ogImage={site.og.home}
  current="about"
  jsonLd={aboutJsonLd()}
>
  <div class="intro">
    <h1 class="display">About</h1>
    <Picture src={photo} alt="Harish Manoharan" widths={[240, 480]} sizes="(min-width: 56.25em) 240px, (min-width: 45em) 160px, 240px" formats={['avif', 'webp']} loading="eager" class="photo" />
    <div class="story">
      <p>
        I’m a software engineer at Purgo AI. I joined in June 2025 as an intern during my M.S. at UT Dallas and
        have been full-time since June 2026. Our agent turns data-engineering tickets into Databricks and dbt code,
        and I work on how it {retrieval ? <a href={retrieval}>finds the tables a ticket needs</a> : 'finds the tables a ticket needs'} and checks the code it
        writes. I also wrote the tests our validation engine uses to {evaluation ? <a href={evaluation}>qualify LLMs and Databricks platforms for regulated use</a> : 'qualify LLMs and Databricks platforms for regulated use'}.
      </p>
      <p>
        Outside Purgo, I’m building <span class="nowrap">a11y-stem</span> on my own. It turns a STEM course PDF into
        an accessible web page, and I score its equations against OpenStax textbooks, whose online editions carry
        expert-written MathML.
      </p>
      <p>
        Before Purgo, I interned at Digitus in 2024, where I built a <span class="nowrap">text-to-SQL</span> agent
        and a retrieval assistant for slide decks and videos, and at PwC in 2023, on sales forecasting. From 2019 to
        2024 I was at IIT Madras, where I studied biology and then data science and wrote my <a href="/Harish___DDP_Report.pdf">master’s thesis</a> with The Jackson Laboratory.
      </p>
    </div>
  </div>

  <section class="section" aria-labelledby="education">
    <h2 id="education" class="section-title">Education</h2>
    <ul class="plain-list edu" role="list">
      <li>
        <h3 class="edu-title">M.S. Computer Science, The University of Texas at Dallas</h3>
        <p class="meta muted">May 2026<span class="vh">,</span> <span aria-hidden="true">·</span> GPA 3.92/4.00<span class="vh">,</span> <span aria-hidden="true">·</span> Dean’s Graduate Scholar</p>
      </li>
      <li>
        <h3 class="edu-title">Dual degree: M.Tech Data Science and B.S. Biological Sciences, IIT Madras</h3>
        <p class="meta muted">2024<span class="vh">,</span> <span aria-hidden="true">·</span> INSPIRE Scholar<span class="vh">,</span> <span aria-hidden="true">·</span> Young Research Fellow</p>
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="research-about">
    <h2 id="research-about" class="section-title">Research and coursework</h2>
    <ul class="plain-list rows" role="list">
      {studies().map((item) => <WorkRow item={item} compact />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="outside">
    <h2 id="outside" class="section-title">Outside work</h2>
    <p class="outside-body">
      These days I go hiking, play table tennis, read, and play fast chess on <a href={site.lichess} rel="me">Lichess</a>.
      At IIT Madras I headed the coding and logic events at Shaastra, the student-run technical festival. Those
      events drew 6,000+ participants. Before that, I taught greedy and dynamic-programming sessions in the
      programming club.
    </p>
  </section>

  <section class="section" aria-labelledby="contact">
    <h2 id="contact" class="section-title">Contact</h2>
    <p class="outside-body">
      Email is best: <a href={`mailto:${site.email}`}>{site.email}</a>. I’m {site.handle} on GitHub, LinkedIn and Lichess.
      I live in the {site.location}.
    </p>
  </section>
</BaseLayout>

<style>
  /* Stacked (h1, photo, story) on narrow screens; from 45em the photo moves to a right column beside the
     h1 and story, top-aligned and ending on the container's right edge, so the h1 sits at the same height as
     on every other page. The photo is 160px wide up to 56.25em and 240px from there. */
  .intro {
    margin-top: var(--title-top);
  }
  .intro :global(.photo) {
    width: 240px;
    height: auto;
    border-radius: 4px;
  }
  /* Picture puts the class on the img; the grid item is the picture element around it. */
  .intro :global(picture) {
    margin-top: 1.5rem;
  }
  .story {
    margin-top: 2rem;
    max-width: var(--measure);
  }
  @media (min-width: 45em) {
    .intro {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(160px, 1fr);
      grid-template-areas:
        'title photo'
        'story photo';
      grid-template-rows: auto 1fr;
      column-gap: var(--gap);
    }
    .intro h1 {
      grid-area: title;
    }
    .intro :global(picture) {
      grid-area: photo;
      justify-self: end;
      align-self: start;
      margin-top: 0;
    }
    .intro :global(.photo) {
      width: 160px;
    }
    .story {
      grid-area: story;
    }
  }
  @media (min-width: 56.25em) {
    .intro {
      grid-template-columns: minmax(0, var(--measure)) minmax(240px, 1fr);
    }
    .intro :global(.photo) {
      width: 240px;
    }
  }
  .story p + p {
    margin-top: 1.25rem;
  }
  .edu {
    margin-top: 1rem;
  }
  .edu li + li {
    margin-top: 1rem;
  }
  .edu-title {
    font-size: var(--fs-body);
    font-weight: 650;
    line-height: 1.4;
  }
  .rows {
    margin-top: 1rem;
  }
  .outside-body {
    margin-top: 0.75rem;
    max-width: var(--measure);
  }
</style>
