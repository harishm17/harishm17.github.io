---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import { site } from '../../data/site';
import { GROUPS, byGroup } from '../../data/work';
import { publishedSlugs } from '../../lib/collection';
import { workHref } from '../../lib/published';

const slugs = await publishedSlugs();
---
<BaseLayout
  title={`Work: ${site.name}`}
  description="Work at Purgo AI and before, research, coursework and side projects by Harish Manoharan, with write-ups where they exist."
  ogImage={site.og.home}
  current="work"
>
  <h1 class="display page-title">Work</h1>
  <p class="lede">My work at Purgo and before it, plus research, coursework and side projects. Linked titles open the write-up that covers them.</p>
  {GROUPS.map((g) => (
    <section class="section" aria-labelledby={g.id}>
      <h2 id={g.id} class="section-title">{g.title}</h2>
      <ul class="plain-list rows" role="list">
        {byGroup(g.id).map((item) => <WorkRow item={item} href={workHref(slugs, item.page, item.anchor)} hideContext={g.id === 'purgo'} />)}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .page-title {
    margin-top: 3rem;
  }
  .lede {
    margin-top: 1rem;
    max-width: 640px;
  }
  .rows {
    margin-top: 1rem;
  }
</style>
