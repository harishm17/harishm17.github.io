---
import { render } from 'astro:content';
import WriteupLayout from '../../layouts/WriteupLayout.astro';
import { getPublished } from '../../lib/collection';

export async function getStaticPaths() {
  const entries = await getPublished();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries.length > 1 ? entries[(i + 1) % entries.length] : undefined },
  }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
---
<WriteupLayout entry={entry} next={next}>
  <Content />
</WriteupLayout>
