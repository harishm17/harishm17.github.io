---
import { site } from '../data/site';

interface Props {
  current?: 'work' | 'about' | null;
  inWriteup?: boolean;
}
const { current = null, inWriteup = false } = Astro.props;
const items = [
  { key: 'work', label: 'Work', href: '/work/' },
  { key: 'about', label: 'About', href: '/about/' },
  { key: 'resume', label: 'Resume', href: site.resume },
] as const;
---
<header class="site-head container">
  <a class="name hit" href="/">{site.name}</a>
  <nav aria-label="Main">
    <ul class="plain-list nav" role="list">
      {items.map((item) => (
        <li>
          <a
            class="hit"
            href={item.href}
            aria-current={item.key === current ? (inWriteup ? 'true' : 'page') : undefined}
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
  }
  .name {
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  .nav a {
    font-weight: 500;
    text-decoration: none;
  }
  .name:hover,
  .nav a:hover,
  .nav a[aria-current] {
    text-decoration: underline;
  }
  @media (max-width: 25em) {
    .site-head,
    .nav {
      column-gap: 0.75rem;
    }
    .nav a {
      font-size: var(--fs-meta);
    }
  }
</style>
