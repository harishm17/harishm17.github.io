---
import { barPercent } from '../lib/results';

interface Props {
  before: number;
  after: number;
  max: number;
  scaleLabel: string;
}
const { before, after, max, scaleLabel } = Astro.props;
const b = barPercent(before, max);
const a = barPercent(after, max);
---
<div class="bars" aria-hidden="true">
  <div class="track">
    <span class="bar-before" style={`width: max(2px, ${b}%)`}></span>
    <span class="bar-after" style={`width: max(2px, ${a}%)`}></span>
  </div>
  <div class="scale"><span>0</span><span>{scaleLabel}</span></div>
</div>

<style>
  .bars {
    margin-top: 0.75rem;
  }
  .track {
    display: grid;
    row-gap: 4px;
    padding-block: 2px;
    border-left: 1px solid var(--ink);
  }
  .track span {
    display: block;
    height: 0;
    border-top: 8px solid var(--bar-before);
  }
  .track .bar-after {
    border-top-color: var(--accent);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-size: var(--fs-tick);
    line-height: 1;
    color: var(--muted);
  }
</style>
