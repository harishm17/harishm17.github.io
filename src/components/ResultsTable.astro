---
import DataTable from './DataTable.astro';
import { getResult } from '../data/results';

interface Props {
  id: string;
  caption: string;
  ids: string[];
}
const { id, caption, ids } = Astro.props;
const rows = ids.map((rid) => {
  const r = getResult(rid);
  return {
    header: r.short,
    sub: r.sample,
    cells: [r.before.text, r.display ? `${r.after.text} (${r.display})` : r.after.text],
  };
});
---
<DataTable
  id={id}
  caption={caption}
  columns={[{ label: 'Metric' }, { label: 'Before', numeric: true }, { label: 'After', numeric: true }]}
  rows={rows}
/>
