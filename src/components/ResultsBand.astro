---
import Bars from './Bars.astro';
import Figure from './Figure.astro';
import type { Result } from '../data/results';

interface Props {
  results: Result[];
}
const { results } = Astro.props;
---
<section class="band" aria-labelledby="results-title">
  <h2 id="results-title" class="vh">Results</h2>
  <ul class="plain-list cells" role="list">
    {results.map((r) => (
      <li class="cell">
        <p class="label">{r.short}</p>
        <Figure before={r.before} after={r.after} display={r.display} spoken={r.spoken} />
        <Bars before={r.before.value} after={r.after.value} max={r.max} scaleLabel={r.scaleLabel} />
        <p class="sample meta muted">{r.sample}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .cells {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    container-type: inline-size;
    border-top: 1px solid var(--ink);
    padding-top: 0.75rem;
  }
  .cell > :global(.figure) {
    order: -1;
    margin-bottom: 0.5rem;
  }
  .label {
    font-weight: 500;
    line-height: 1.35;
  }
  .sample {
    margin-top: 0.5rem;
  }
  @media (min-width: 56.25em) {
    .cells {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gap);
    }
  }
</style>
