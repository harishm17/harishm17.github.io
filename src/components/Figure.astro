---
import Arrow from './Arrow.astro';
import type { Value } from '../data/results';
import { spokenChange } from '../lib/results';

interface Props {
  before: Value;
  after: Value;
  display?: string;
  spoken?: string;
}
const { before, after, display, spoken } = Astro.props;
const said = display ? (spoken ?? display) : spokenChange({ before, after });
---
<p class="figure">
  <span class="vh">{said}</span>
  <span aria-hidden="true">
    {display ? (
      <span class="now">{display}</span>
    ) : (
      <>
        <span class="was">{before.text}</span><span class="tail"><Arrow /><span class="now">{after.text}</span></span>
      </>
    )}
  </span>
</p>

<style>
  .figure {
    font-size: clamp(1.375rem, min(17cqi, calc(var(--display) * 0.85)), 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .was {
    font-weight: 400;
  }
  .now {
    font-weight: 650;
  }
  .tail {
    white-space: nowrap;
  }
</style>
