---
interface Step {
  label: string;
  mine?: boolean;
}
interface Props {
  caption: string;
  steps: Step[];
}
const { caption, steps } = Astro.props;
---
<figure class="steps">
  <ol class="plain-list step-list" role="list">
    {steps.map((s) => (
      <li class:list={{ mine: s.mine }}>{s.label}{s.mine && <span class="mine-note"> (my part)</span>}</li>
    ))}
  </ol>
  <figcaption class="meta muted">{caption}</figcaption>
</figure>

<style>
  .steps {
    margin-block: 1.5rem;
  }
  .step-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 26rem;
  }
  .step-list li {
    position: relative;
    border: 1px solid var(--ink);
    padding: 0.375rem 0.75rem;
    font-size: var(--fs-meta);
  }
  .step-list li + li::before {
    content: "";
    position: absolute;
    left: 1.25rem;
    top: calc(-1rem - 1px);
    height: 1rem;
    border-left: 1px solid var(--ink);
  }
  .step-list li.mine {
    font-weight: 650;
    border-width: 2px;
  }
  figcaption {
    margin-top: 0.75rem;
  }
</style>
