{
  "name": "harishm17-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run tests/unit",
    "test:dist": "vitest run tests/dist",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/index.html\" \"dist/404.html\" \"dist/about/index.html\" \"dist/work/**/*.html\"",
    "check:links": "linkinator dist --recurse --check-fragments --skip \"^(?!http://(127\\.0\\.0\\.1|localhost)[:/])\"",
    "check:external": "node scripts/check-external.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "og": "node scripts/og.mjs",
    "favicons": "node scripts/favicons.mjs",
    "verify": "npm run build && npm test && npm run test:dist && npm run validate:html && npm run check:links && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "linkedom": "^0.18.13",
    "linkinator": "^8.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
